# Токен от BotFather
BOT_TOKEN=
# Имя бота без @, нужно для ссылок возврата
BOT_USERNAME=
# Пароль базы для контейнера postgres
POSTGRES_PASSWORD=
# Строка подключения к PostgreSQL, с тем же паролем (для разработки порт 5433)
DATABASE_URL=
# Telegram ID админов через запятую
ADMIN_IDS=
# Кому присылать резервные копии
OWNER_ID=
# Чат заказов
ORDERS_CHAT_ID=
# Закрытый канал
CHANNEL_ID=
# Ссылка на вступление в закрытый канал
CHANNEL_INVITE_LINK=
# Ссылка на каталог приложений
CATALOG_URL=
# Ссылка на отзывы
REVIEWS_URL=
# Ссылка на поддержку
SUPPORT_URL=
# Ссылка на оферту
OFFER_URL=
# Ссылка на инструкцию по UDID
UDID_HELP_URL=
# Идентификатор мерчанта Platega
PLATEGA_MERCHANT_ID=
# Секрет Platega
PLATEGA_SECRET=
# Ключ шифрования сертификатов: 32 байта в base64
CERT_ENCRYPTION_KEY=
# Пароль резервных копий
BACKUP_PASSPHRASE=
# Папка с текстами и картинкой
CONTENT_DIR=./content
# Тестовая база для интеграционных тестов
DATABASE_URL_TEST=postgresql://bot:bot@127.0.0.1:5433/xstorexbot_test
