generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentProvider {
  PLATEGA
  STARS
  MANUAL
}

enum PaymentCurrency {
  RUB
  XTR
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
  EXPIRED
  REFUNDED
  CHARGEBACK
}

enum CertRequestStatus {
  OPEN
  ISSUED
  REJECTED
}

model User {
  id             BigInt    @id
  username       String?
  firstName      String
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  blockedAt      DateTime? @db.Timestamptz(3)
  udidExpectedAt DateTime? @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @db.Timestamptz(3)

  subscription        Subscription?
  payments            Payment[]
  certRequests        CertRequest[]
  broadcastRecipients BroadcastRecipient[]
}

model Plan {
  id         Int     @id @default(autoincrement())
  days       Int     @unique
  priceRub   Int
  priceStars Int?
  enabled    Boolean @default(true)
  sort       Int

  payments Payment[]
}

model Subscription {
  userId         BigInt    @id
  endsAt         DateTime  @db.Timestamptz(3)
  reminded3dAt   DateTime? @db.Timestamptz(3)
  reminded1dAt   DateTime? @db.Timestamptz(3)
  removedAt      DateTime? @db.Timestamptz(3)
  removeAttempts Int       @default(0)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  userId            BigInt
  planId            Int?
  provider          PaymentProvider
  days              Int
  amount            Int
  currency          PaymentCurrency
  status            PaymentStatus   @default(PENDING)
  providerStatus    String?
  providerPaymentId String?         @unique
  paymentUrl        String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  paidAt            DateTime?       @db.Timestamptz(3)
  appliedAt         DateTime?       @db.Timestamptz(3)
  lastCheckedAt     DateTime?       @db.Timestamptz(3)
  createdByAdminId  BigInt?

  user User  @relation(fields: [userId], references: [id])
  plan Plan? @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status, createdAt])
}

model CertRequest {
  id                  Int               @id @default(autoincrement())
  userId              BigInt
  udid                String
  status              CertRequestStatus @default(OPEN)
  p12Enc              Bytes?
  profileEnc          Bytes?
  passwordEnc         Bytes?
  certExpiresAt       DateTime?         @db.Timestamptz(3)
  ordersChatMessageId Int?
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  issuedAt            DateTime?         @db.Timestamptz(3)
  issuedByAdminId     BigInt?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AdminLog {
  id           Int      @id @default(autoincrement())
  adminId      BigInt
  action       String
  targetUserId BigInt?
  details      Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
}

enum BroadcastStatus {
  RUNNING
  DONE
  STOPPED
  FAILED
}

enum RecipientStatus {
  PENDING
  SENT
  BLOCKED
  FAILED
}

model Broadcast {
  id                Int             @id @default(autoincrement())
  adminId           BigInt
  sourceChatId      BigInt
  sourceMessageId   Int
  buttonText        String?
  buttonUrl         String?
  status            BroadcastStatus @default(RUNNING)
  total             Int
  progressMessageId Int?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  finishedAt        DateTime?       @db.Timestamptz(3)

  recipients BroadcastRecipient[]
}

model BroadcastRecipient {
  broadcastId Int
  userId      BigInt
  status      RecipientStatus @default(PENDING)
  error       String?
  sentAt      DateTime?       @db.Timestamptz(3)

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@id([broadcastId, userId])
  @@index([broadcastId, status])
}
